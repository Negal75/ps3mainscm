set_lvar_text_label 345@s = 'WUZ1_CA' // The Blood Feather Triad have a storehouse around the block.
set_lvar_text_label 347@s = 'WUZ1_CB' // We shall see what excuses they have to offer.
set_lvar_text_label 349@s = 'WUZ1_CC' // OK. So what's all this talk of business?
set_lvar_text_label 351@s = 'WUZ1_CD' // Some small time Vietnamese gangs have been making trouble lately.
set_lvar_text_label 353@s = 'WUZ1_CE' // We're not sure why they're gaining any courage now, but I'm nervous about the situation.
set_lvar_text_label 357@s = 'WUZ1_CG' // How do I fit in all of this?
set_lvar_text_label 359@s = 'WUZ1_CH' // You're an outsider.
set_lvar_text_label 361@s = 'WUZ1_DA' // This is the place!
set_lvar_text_label 363@s = 'WUZ1_DD' // Come on, it's this way.
set_lvar_text_label 365@s = 'WUZ1_DB' // What's that smell?
set_lvar_text_label 367@s = 'WUZ1_DC' // Laundry.
set_lvar_text_label 369@s = 'WUZ1_LA' // Ah, we're here! This way!
set_lvar_text_label 371@s = 'WUZ1_LC' // Strange, this gate is usually locked.
set_lvar_text_label 373@s = 'WUZ1_KD' // Stick Close!
set_lvar_text_label 375@s = 'WUZ1_MA' // Oh man, Woozie...
set_lvar_text_label 377@s = 'WUZ1_MB' // What's got spooked?
set_lvar_text_label 379@s = 'WUZ1_MC' // Oh, oh sorry, didn't see you lying down there.
set_lvar_text_label 381@s = 'WUZ1_MD' // He's dead. They all are.
set_lvar_text_label 383@s = 'WUZ1_ME' // The Blood Feathers, wiped out?
set_lvar_text_label 385@s = 'WUZ1_MF' // Dai Dai Lo! Forgive me, I was too scared to fight, so I hid.
set_lvar_text_label 387@s = 'WUZ1_MG' // Enough! What happened here?
set_lvar_text_label 389@s = 'WUZ1_MH' // Vietnamese surprised us, cut us all down.
set_lvar_text_label 391@s = 'WUZ1_MJ' // Shit, here they come again!
set_lvar_text_label 395@s = 'WUZ1_MH' // Vietnamese surprised us, cut us all down.
set_lvar_text_label 397@s = 'WUZ1_MJ' // Shit, here they come again!
set_lvar_text_label 399@s = 'WUZ1_NA' // The Triads must have vengeance!
set_lvar_text_label 401@s = 'WUZ1_NB' // CJ, follow me and stick close!
set_lvar_text_label 403@s = 'WUZ1_NC' // Ready?
set_lvar_text_label 405@s = 'WUZ1_ND' // DIE YOU MOTHERFUCKING SONS OF WHORES!
set_lvar_text_label 407@s = 'WUZ1_NE' // Looks clear to me, go! Go!
set_lvar_text_label 409@s = 'WUZ1_NF' // I think I got them all!
set_lvar_text_label 411@s = 'WUZ1_NG' // Hell's sewers, that was a sniper bullet!
set_lvar_text_label 413@s = 'WUZ1_NH' // Damn, I err, got something in my eyes, is it safe to move?
set_lvar_text_label 415@s = 'WUZ1_NJ' // YOUR MOTHERS WERE DEMON SLUTS!
set_lvar_text_label 417@s = 'WUZ1_NK' // YOUR BLOOD WILL RUN LIKE WINE!
set_lvar_text_label 419@s = 'WUZ1_NL' // EAT THIS HOT LEADEN SHIT!
set_lvar_text_label 421@s = 'WUZ1_NM' // YOU WILL WANDER AS GHOSTS!
set_lvar_text_label 423@s = 'WUZ1_NN' // CURSED ASSHOLES!
set_lvar_text_label 425@s = 'WUZ1_NO' // CJ, take out that sniper!
set_lvar_text_label 427@s = 'WUZ1_NP' // Cover me, CJ, I'm moving up!
set_lvar_text_label 429@s = 'WUZ1_NQ' // I'm breaking cover, CJ, spray 'em!
set_lvar_text_label 431@s = 'WUZ1_OA' // Oh fuck, man, more up ahead!
set_lvar_text_label 433@s = 'WUZ1_OB' // Shit, man, they really want you dead!
set_lvar_text_label 435@s = 'WUZ1_OC' // I see him. He on the roof!
set_lvar_text_label 437@s = 'WUZ1_OD' // OK, clear, Woozie, GO!
set_lvar_text_label 439@s = 'WUZ1_OE' // Break for it, Woozie!
