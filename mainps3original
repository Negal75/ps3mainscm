set_lvar_text_label 320@s = 'SWE7_AA' // We're gonna need some allies.
set_lvar_text_label 322@s = 'SWE7_AB' // Yeah I'm gonna call up the homies and get us a little crew.
set_lvar_text_label 324@s = 'SWE7_AC' // But I warned you about putting time in for the homies.
set_lvar_text_label 326@s = 'SWE7_AD' // You ain't got enough stripes to rally up the troops.
set_lvar_text_label 328@s = 'SWE7_AE' // What can I do about that now?
set_lvar_text_label 330@s = 'SWE7_AF' // Head over to Ballas' hood, and put some work in.
set_lvar_text_label 332@s = 'SWE7_AG' // Bad news travels fast.
set_lvar_text_label 334@s = 'SWE7_AH' // I'll be waiting for you back here.
set_lvar_text_label 336@s = 'SWE7_BA' // Cool, we'll take my ride.
set_lvar_text_label 338@s = 'SWE7_BB' // Hey, where to?
set_lvar_text_label 340@s = 'SWE7_BC' // Just along the block up there by the bridge.
set_lvar_text_label 342@s = 'SWE7_BD' // I know a couple of Grove Streets we can bring along.
set_lvar_text_label 344@s = 'SWE7_BE' // A Grove posse? Man, you know I'm down with that.
set_lvar_text_label 346@s = 'SWE7_CA' // Get out and muster up the troops, CJ!
set_lvar_text_label 348@s = 'SWE7_CB' // There they go - get out and bring them along.
set_lvar_text_label 350@s = 'SWE7_CC' // There they are, go get 'em!
set_lvar_text_label 352@s = 'SWE7_DA' // CJ, you been hitting Ryder's wet stick?
set_lvar_text_label 354@s = 'SWE7_DB' // What the fuck you doing, CJ?
set_lvar_text_label 356@s = 'SWE7_DC' // Oh, CJ, you such a asshole!
set_lvar_text_label 358@s = 'SWE7_DD' // Tell those guys to beat it - I got two OGs in mind.
set_lvar_text_label 360@s = 'SWE7_DE' // I told you I had two Gs in mind - tell these fools to roll!
set_lvar_text_label 362@s = 'SWE7_EA' // OK, let's cut corners - we got a couple of homies to meet up with.
set_lvar_text_label 364@s = 'SWE7_EB' // We'll go around back of Los Sepulcros and sneak over the wall.
set_lvar_text_label 366@s = 'SWE7_EC' // C'mon, CJ, we gotta get in position before the funeral starts.
set_lvar_text_label 368@s = 'SWE7_ED' // Get a move on, CJ, we gonna be late!
set_lvar_text_label 370@s = 'SWE7_EE' // We got get there early, CJ!
set_lvar_text_label 372@s = 'SWE7_EF' // We missed the damn funeral!
set_lvar_text_label 374@s = 'SWE7_EG' // Too late, man, the funeral's over.
set_lvar_text_label 376@s = 'SWE7_EH' // This is it.
set_lvar_text_label 378@s = 'SWE7_EJ' // Carl, you stay put while we hop over the wall and check it out.
set_lvar_text_label 380@s = 'SWE7_EK' // OK, CJ, come on over!
set_lvar_text_label 382@s = 'SWE7_FA' // Y'all know CJ, right?
set_lvar_text_label 384@s = 'SWE7_FB' // These two boys been watching Front Yard Ballas set things up.
set_lvar_text_label 386@s = 'SWE7_GA' // Y'all take up positions, and wait for Kane.
set_lvar_text_label 388@s = 'SWE7_GB' // Kane? Ain't that cat front yard royalty?
set_lvar_text_label 390@s = 'SWE7_GC' // Yeah, so if there's a hint of trouble, he's a no-show.
set_lvar_text_label 392@s = 'SWE7_HA' // CJ. you fool, Kane won't show now!
set_lvar_text_label 394@s = 'SWE7_HB' // Aw, man, Kane ain't gonna show now.
set_lvar_text_label 396@s = 'SWE7_HC' // You blew the ambush, CJ, you buster!
set_lvar_text_label 398@s = 'SWE7_JA' // Here he comes...
set_lvar_text_label 400@s = 'SWE7_JB' // Looks like that buster's wearing armor.
set_lvar_text_label 402@s = 'SWE7_JC' // Might take a round or two to drop his ass.
set_lvar_text_label 404@s = 'SWE7_KA' // OK, CJ, you take Kane, and we'll take the rest of these fools out.
set_lvar_text_label 406@s = 'SWE7_KB' // You take Kane, CJ - we got the small fry.
set_lvar_text_label 408@s = 'SWE7_KC' // CJ, you take care of Kane - you guys, take care of these other marks!
set_lvar_text_label 410@s = 'SWE7_LA' // Kane's headed for that Ballas car!
set_lvar_text_label 412@s = 'SWE7_LB' // There's a Ballas car coming to bail out Kane!
set_lvar_text_label 414@s = 'SWE7_LC' // Kane's bailing!
set_lvar_text_label 416@s = 'SWE7_MA' // C'mon, we'll take that car over there!
set_lvar_text_label 418@s = 'SWE7_MB' // C'mon, let's use this car!
set_lvar_text_label 420@s = 'SWE7_MC' // We can take this car!
set_lvar_text_label 422@s = 'SWE7_MD' // Get that ride for us, CJ!
set_lvar_text_label 424@s = 'SWE7_NA' // OK, I've busted in, c'mon!
set_lvar_text_label 426@s = 'SWE7_NB' // C'mon, CJ, I've busted into this bucket!
set_lvar_text_label 428@s = 'SWE7_OA' // Smash, CJ, smash! We gotta catch him before he reaches the Front Yard set!
set_lvar_text_label 430@s = 'SWE7_OB' // Stamp it, CJ, we gotta get after that fool before he gets home!
set_lvar_text_label 432@s = 'SWE7_PA' // Get me close, CJ!
set_lvar_text_label 434@s = 'SWE7_PB' // Keep it steady!
set_lvar_text_label 436@s = 'SWE7_PC' // Get me alongside!
set_lvar_text_label 438@s = 'SWE7_PD' // Get alongside so I can blast this fool!
set_lvar_text_label 440@s = 'SWE7_QA' // Aw, shit, he's safe and sound now.
set_lvar_text_label 442@s = 'SWE7_QB' // Aw, shit, he done made it to the pizzad.
set_lvar_text_label 444@s = 'SWE7_QC' // Aw fuck! He outran us, FUCK!
set_lvar_text_label 446@s = 'SWE7_RA' // Eat that you Front Yard FOOL!
set_lvar_text_label 448@s = 'SWE7_RB' // Nobody messes with GROVE STREET!
set_lvar_text_label 450@s = 'SWE7_RC' // C'mon, let's bail back to Ganton!
set_lvar_text_label 452@s = 'SWE7_SA' // Nice one, CJ!
set_lvar_text_label 454@s = 'SWE7_SB' // I'll get us a getaway car, you guys take out the rest of those Ballas!
set_lvar_text_label 456@s = 'SWE7_SC' // OK, everybody in, let's roll!
set_lvar_text_label 458@s = 'SWE7_TA' // Man, we was a force back there.
set_lvar_text_label 460@s = 'SWE7_TB' // Everybody go home, stay low, we ain't seen each other all day, copy?
