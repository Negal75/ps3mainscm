set_lvar_text_label 443@s = 'WUZ1_OG' // Hold up, Woozie, we still got trouble!
set_lvar_text_label 445@s = 'WUZ1_OH' // Lay low!
set_lvar_text_label 447@s = 'WUZ1_OJ' // Woozie, keep it down, we still got trouble!
set_lvar_text_label 449@s = 'WUZ1_OK' // In the car, quick!
set_lvar_text_label 451@s = 'WUZ1_OL' // Get on the back of the bike!
set_lvar_text_label 453@s = 'WUZ1_OM' // On the bike, quick!
set_lvar_text_label 455@s = 'WUZ1_ON' // Let's get the fuck out of here!
set_lvar_text_label 457@s = 'WUZ1_OO' // Let's get the hell out of here!
set_lvar_text_label 459@s = 'WUZ1_OP' // We got more company!
set_lvar_text_label 461@s = 'WUZ1_OQ' // Cars on our tail!
set_lvar_text_label 463@s = 'WUZ1_OR' // More of them, in cars!
set_lvar_text_label 465@s = 'WUZ1_PA' // You drive, I'll send them back to the sewers!
set_lvar_text_label 467@s = 'WUZ1_PB' // Keep driving, I'll take care of these murderous scum!
set_lvar_text_label 469@s = 'WUZ1_QA' // That look like the last of 'em.
set_lvar_text_label 471@s = 'WUZ1_RA' // Thank you, Carl, you saved me from having to kill them all myself.
set_lvar_text_label 473@s = 'WUZ1_QB' // OK, let's get back to my place.
set_lvar_text_label 475@s = 'WUZ1_RD' // Here, a token of the Tong's appreciation for what you did today.
set_lvar_text_label 477@s = 'WUZ1_EA' // Hey, what's with all these people?
set_lvar_text_label 479@s = 'WUZ1_EB' // Where they going?
set_lvar_text_label 481@s = 'WUZ1_EC' // Something isn't right here. We should be careful...
set_lvar_text_label 483@s = 'WUZ1_EE' // Follow me.
set_lvar_text_label 485@s = 'WUZ1_GJ' // Now... where's that loose cobble?
set_lvar_text_label 487@s = 'WUZ1_JA' // Hey, what the hell you doin'?
set_lvar_text_label 489@s = 'WUZ1_JB' // Just, eerr, checking the, um, y'know. Shut up, Carl.... THIS WAY!
set_lvar_text_label 493@s = 'WUZ1_GC' // Hmmm, yes, intriguing...
set_lvar_text_label 495@s = 'WUZ1_KA' // What's wrong? You lost? Need a hand?
set_lvar_text_label 497@s = 'WUZ1_KB' // NO!
set_lvar_text_label 499@s = 'WUZ1_KC' // No, I was just, you know, getting the feel of the place.
set_lvar_text_label 501@s = 'WUZ1_KD' // Stick Close!
set_lvar_text_label 503@s = 'WUZ1_GE' // Was it fifteen paces, or fifteen feet?
set_lvar_text_label 505@s = 'WUZ1_GF' // Ah, no, now I've got it...
set_lvar_text_label 507@s = 'WUZ1_FA' // Something's not right.
set_lvar_text_label 509@s = 'WUZ1_FB' // No shit, where everybody at?
set_lvar_text_label 511@s = 'WUZ1_FC' // Hiding, scared. I can smell them.
set_lvar_text_label 513@s = 'WUZ1_FD' // We should proceed with caution.
set_lvar_text_label 515@s = 'WUZ1_FE' // This way, I think.
set_lvar_text_label 517@s = 'WUZ1_HA' // Do you hear something?
set_lvar_text_label 519@s = 'WUZ1_HB' // Yeah, traffic and other shit.
set_lvar_text_label 521@s = 'WUZ1_HC' // Exactly! Trust me, I know what I'm doing. Follow me!
