set_var_text_label s$8382[0] = 'GAR1_AA' // C'mon, man, there's these two guys I know - used to work on marine engines,
set_var_text_label s$8382[1] = 'GAR1_AB' // 'til the mob bought their business over in Vice.
set_var_text_label s$8382[2] = 'GAR1_AC' // Now they try and make ends meet by taking any old job.
set_var_text_label s$8382[3] = 'GAR1_AD' // They're a little bit dulled by their habit,
set_var_text_label s$8382[4] = 'GAR1_AE' // but the smoke don't get in the way of their skills with an engine.
set_var_text_label s$8382[5] = 'GAR1_AF' // We'll pick up Jethro first.
set_var_text_label s$8382[6] = 'GAR1_AG' // Last I heard, he was working at a garage over Easter Basin.
set_var_text_label s$8382[7] = 'GAR1_AH' // Last I heard, he was working at a garage over East Esplanade way.
set_var_text_label s$8382[8] = 'GAR1_AJ' // Last I heard, he was working at a garage over North Esplanade way.
set_var_text_label s$8382[9] = 'GAR1_BA' // Hey man, how'd you meet these dudes anyway?
set_var_text_label s$8382[10] = 'GAR1_BB' // I met them at the '89 Fierro Love-in, apparently.
set_var_text_label s$8382[11] = 'GAR1_BC' // Apparently?
set_var_text_label s$8382[12] = 'GAR1_BD' // You know how it is, man,
set_var_text_label s$8382[13] = 'GAR1_BE' // a field of tents, crazy-assed music,
set_var_text_label s$8382[14] = 'GAR1_BF' // a quart of mescaline vodka, polar bears...
set_var_text_label s$8382[15] = 'GAR1_BG' // Polar bears?
set_var_text_label s$8382[16] = 'GAR1_BH' // Yeah. Go figure. But they were funny guys, man - great sense of humor.
set_var_text_label s$8382[17] = 'GAR1_CA' // This here's Vietnamese gang territory.
set_var_text_label s$8382[18] = 'GAR1_CB' // Da Nang Boys, Shining Razors, Butterfly Children.
set_var_text_label s$8382[19] = 'GAR1_CC' // Watch yourself, dude. These cats are real serious.
set_var_text_label s$8382[20] = 'GAR1_DA' // Hey, Jethro!
set_var_text_label s$8382[21] = 'GAR1_DF' // Hop in, man. I've landed you a real job.
set_var_text_label s$8382[22] = 'GAR1_DB' // Hey there Truth dude!
set_var_text_label s$8382[23] = 'GAR1_DC' // Oh man, do I owe you?
set_var_text_label s$8382[24] = 'GAR1_DD' // Coz I swear I paid for that weed, dude!
set_var_text_label s$8382[25] = 'GAR1_DE' // No, man, we're good, I think.
set_var_text_label s$8382[26] = 'GAR1_EA' // Jethro, Carl. Carl, Jethro.
set_var_text_label s$8382[27] = 'GAR1_EB' // Wassup man.
set_var_text_label s$8382[28] = 'GAR1_EC' // Can we swing by the hospital, it's over in Santa Flora district, west of here.
set_var_text_label s$8382[29] = 'GAR1_ED' // Yeah, you sick?
set_var_text_label s$8382[30] = 'GAR1_EE' // No. The government is, but that's a long story.
set_var_text_label s$8382[31] = 'GAR1_FA' // So y'know, like what's the deal, dudes?
set_var_text_label s$8382[32] = 'GAR1_FB' // I'm opening a garage in Doherty by the waste ground.
set_var_text_label s$8382[33] = 'GAR1_FC' // You know, car mods, lowriders, all that shit.
set_var_text_label s$8382[34] = 'GAR1_FD' // You down?
set_var_text_label s$8382[35] = 'GAR1_FE' // Do polar bears shit in the woods?
set_var_text_label s$8382[36] = 'GAR1_FF' // No, but they've been known to shit in the liquor tent, if I remember it right.
set_var_text_label s$8382[37] = 'GAR1_FG' // Yeah, that was, like, so far gone, man.
set_var_text_label s$8382[38] = 'GAR1_GA' // What we here for, anyway?
set_var_text_label s$8382[39] = 'GAR1_GB' // Nothin'.
set_var_text_label s$8382[40] = 'GAR1_GC' // Ooh, don't look.
set_var_text_label s$8382[41] = 'GAR1_GD' // Cover your faces.
set_var_text_label s$8382[42] = 'GAR1_GE' // Think about a yellow rubber duck.
set_var_text_label s$8382[43] = 'GAR1_GF' // You tripping again.
set_var_text_label s$8382[44] = 'GAR1_GG' // Sshhh!
set_var_text_label s$8382[45] = 'GAR1_GH' // OK, I've seen enough.
set_var_text_label s$8382[46] = 'GAR1_GI' // Let's go see if we can find Dwaine.
set_var_text_label s$8382[47] = 'GAR1_GJ' // He's working a hotdog van at the tram terminal in King's.
set_var_text_label s$8382[48] = 'GAR1_HA' // C'mon, dude, what's all that about?
set_var_text_label s$8382[49] = 'GAR1_HB' // You don't want to know.
set_var_text_label s$8382[50] = 'GAR1_HC' // Why?
set_var_text_label s$8382[51] = 'GAR1_HD' // Do you know what a sub-dermal neurophone is?
set_var_text_label s$8382[52] = 'GAR1_HE' // A what?
set_var_text_label s$8382[53] = 'GAR1_HF' // Exactly.
set_var_text_label s$8382[54] = 'GAR1_HG' // Sometimes it's best to stay in the dark, kid.
set_var_text_label s$8382[55] = 'GAR1_JA' // Dude, Dwaine, man, how's the hot dog business?
set_var_text_label s$8382[56] = 'GAR1_JB' // It's totally shit. Why, what's happenin'?
set_var_text_label s$8382[57] = 'GAR1_JC' // Uh, my friend Carl here is opening a chop shop.
set_var_text_label s$8382[58] = 'GAR1_JD' // Jethro's in, how about you?
set_var_text_label s$8382[59] = 'GAR1_JE' // Ah yeah, cool man.
set_var_text_label s$8382[60] = 'GAR1_JF' // Uh I've got like some shit to take care of first though.
set_var_text_label s$8382[61] = 'GAR1_JG' // So uh you tell me where you guys are going to be at and I'll meet you dudes there.
set_var_text_label s$8382[62] = 'GAR1_JH' // The garage is on the waste grounds in Doherty.
set_var_text_label s$8382[63] = 'GAR1_JJ' // I'll see y'all later.
set_var_text_label s$8382[64] = 'GAR1_KA' // OK, next stop the cop station downtown.
set_var_text_label s$8382[65] = 'GAR1_KB' // What? You out your mind! Why?
set_var_text_label s$8382[66] = 'GAR1_KC' // If I told you, the likelihood is you'd get a probe up your ass within a month.
set_var_text_label s$8382[67] = 'GAR1_KD' // Like, listen to the man, dude, he's real serious about that shit.
set_var_text_label s$8382[68] = 'GAR1_KE' // Wuh? OK, but you're starting to freak me out with all that space shit, man.
set_var_text_label s$8382[69] = 'GAR1_LA' // OK, you know the drill.
set_var_text_label s$8382[70] = 'GAR1_LB' // Don't look interested in anything.
set_var_text_label s$8382[71] = 'GAR1_LC' // Picture a pink golfball in your mind.
set_var_text_label s$8382[72] = 'GAR1_LD' // OK, we're good to go.
set_var_text_label s$8382[73] = 'GAR1_MA' // Where to next, Spacehead?
set_var_text_label s$8382[74] = 'GAR1_MB' // There's an electronics guy I've had dealings with,
set_var_text_label s$8382[75] = 'GAR1_MC' // goes by the name of ZERO.
set_var_text_label s$8382[76] = 'GAR1_MD' // He could fix a supercomputer with a paperclip.
set_var_text_label s$8382[77] = 'GAR1_ME' // He's got his own shop,
set_var_text_label s$8382[78] = 'GAR1_MF' // but he's always ready to help fellow travelers along the path.
set_var_text_label s$8382[79] = 'GAR1_MG' // Let's go introduce you to him
set_var_text_label s$8382[80] = 'GAR1_NA' // Look, what's goin' on, Truth?
set_var_text_label s$8382[81] = 'GAR1_NB' // Who was them dudes?
set_var_text_label s$8382[82] = 'GAR1_NC' // Don't go there, man.
set_var_text_label s$8382[83] = 'GAR1_ND' // Listen to Jethro.
set_var_text_label s$8382[84] = 'GAR1_NE' // Now, what if I told you we never went to the moon,
set_var_text_label s$8382[85] = 'GAR1_NF' // JFK lives in Scotland with Janis Joplin,
set_var_text_label s$8382[86] = 'GAR1_NG' // and the only reason we've been in a cold war for the last forty-five years,
set_var_text_label s$8382[87] = 'GAR1_NH' // was because snake-headed aliens run the oil business?
set_var_text_label s$8382[88] = 'GAR1_NJ' // I think you popped another microdot.
set_var_text_label s$8382[89] = 'GAR1_NK' // Good. Keep it that way.
set_var_text_label s$8382[91] = 'GAR1_OA' // Blow the horn.
set_var_text_label s$8382[92] = 'GAR1_OB' // Leave me alone Berkley!
set_var_text_label s$8382[93] = 'GAR1_OC' // This is stalking!
set_var_text_label s$8382[94] = 'GAR1_OD' // Oh, hey, Truth.
set_var_text_label s$8382[95] = 'GAR1_OE' // Get in, I'll fill you in as we drive.
set_var_text_label s$8382[96] = 'GAR1_OF' // Home, James!
set_var_text_label s$8382[97] = 'GAR1_PA' // Carl, Zero, Zero, Carl.
set_var_text_label s$8382[98] = 'GAR1_PB' // Sup.
set_var_text_label s$8382[99] = 'GAR1_PC' // Carl here is opening a garage around the corner.
set_var_text_label s$8382[100] = 'GAR1_PD' // I told him you're the man to speak to when it comes to electronics.
set_var_text_label s$8382[101] = 'GAR1_PE' // Actually, I'm the ONLY man to speak to.
set_var_text_label s$8382[102] = 'GAR1_PJ' // Grade A, tip-top genius, that's me.
set_var_text_label s$8382[103] = 'GAR1_PF' // You should drop by the shop sometime, see some of my shit, bro.
set_var_text_label s$8382[104] = 'GAR1_PG' // I'll do that.
set_var_text_label s$8382[105] = 'GAR1_PH' // OK, we here.
